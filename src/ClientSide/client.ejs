<head>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    
    <!--<label for="joueurNumeroB">Joueur Identifiant:</label>
    <input type="number" id="joueurNumeroB" name="joueurNumeroB">-->

    <div id="home-screen">
        <div id="start-content">
            <button id="start-button" class="start-button" role="button">START</button>
        </div>
        <div id="menu-content" style="display: none;">
            <div class="menu-window">
                <h2>Select Room</h2>
                <label for="roomID">Room ID:</label>
                <input type="number" id="roomID" name="roomID"><br>
                <button id="createGameButton">Create Game</button>
                <button id="joinGameButton">Join Game</button>
            </div>
        </div>
    </div>    

    <div id="game-container" style="display: none;">
        <div id="buy-boat">
            <span id="close-btn" style="cursor: pointer; font-size: 20px; position: absolute; top: 10px; right: 10px;">&times;</span>
            <label for="x">X:</label>
            <input type="number" id="x" name="x">
            <label for="y">Y:</label>
            <input type="number" id="y" name="y"> <br> <br>
            <!-- Dropdown for selecting boat type -->
            <div>
                <label for="boat-type">Boat Type:</label><br>
                <input type="radio" id="destroyer" name="boat-type" value="Destroyer" checked onchange="updateBoatDetails()">
                <label for="destroyer">Destroyer</label><br>
            
                <input type="radio" id="sous-marin" name="boat-type" value="SousMarin" onchange="updateBoatDetails()">
                <label for="sous-marin">SousMarin</label><br>
            
                <input type="radio" id="fregate" name="boat-type" value="Fregate" onchange="updateBoatDetails()">
                <label for="fregate">Fregate</label><br>
            </div>
            <div id="boat-details">
                <p id="boat-price"></p>
                <img id="boat-image" src="" alt="" style="display: none; width: 100px; height: auto; margin-top: 10px;">
            </div><br>
            <button onclick="buyBoat()" class="button-54" role="button">Buy boat</button><br>
        </div>

        <div id="shoot-boat">
            <div class="form-group">
                <label for="xAtk">Attaquant X:</label>
                <input type="number" id="xAtk" name="xAtk">
            </div>
            <div class="form-group">
                <label for="yAtk">Attaquant Y:</label>
                <input type="number" id="yAtk" name="yAtk">
            </div>
            <div class="form-group">
                <label for="xDef">Defenseur X:</label>
                <input type="number" id="xDef" name="xDef">
            </div>
            <div class="form-group">
                <label for="yDef">Defenseur Y:</label>
                <input type="number" id="yDef" name="yDef">
            </div>
            <button onclick="shootBoat()" class="button-54" role="button">Shoot Boat</button>
        </div>
        
        <div id="move-boat">
            <div class="form-group">
                <label for="xDep">Depart X:</label>
                <input type="number" id="xDep" name="xDep">
            </div>
            <div class="form-group">
                <label for="yDep">Depart Y:</label>
                <input type="number" id="yDep" name="yDep">
            </div>
            <div class="form-group">
                <label for="xArr">Arrivee X:</label>
                <input type="number" id="xArr" name="xArr">
            </div>
            <div class="form-group">
                <label for="yArr">Arrivee Y:</label>
                <input type="number" id="yArr" name="yArr">
            </div>
            <button onclick="moveBoat()" class="button-54" role="button">Move Boat</button>
        </div>
        
        <button onclick="endTurn()" id="end-turn" class="button-27" role="button">End Turn</button><br>

        <pre id="turn-state"></pre>
        
        <pre id="boat-state"></pre>
        
        <div id="argent-container"></div>

        <div id="game-board"></div>

        <div id="cell-state"></div> <!-- This will display the state of the clicked cell -->
        
    </div>


    <script src="/socket.io/socket.io.js"></script>
    <script src="/client.js"></script>
</body>
